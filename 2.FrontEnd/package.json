{
  "name": "project.cli",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "postinstall": "node scripts/copy-mediapipe.mjs && node scripts/copy-pdfjs.mjs",
    "sync:mediapipe": "node scripts/copy-mediapipe.mjs",
    "sync:pdfjs": "node scripts/copy-pdfjs.mjs",
    "verify:mediapipe": "node scripts/verify-mediapipe-dist.mjs",
    "build": "npm run sync:mediapipe && npm run sync:pdfjs && ng build --configuration production && npm run verify:mediapipe && npm run obfuscate",
    "build:dev": "ng build --configuration development",
    "obfuscate": "node scripts/obfuscate.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.3",
    "@angular/cdk": "^20.1.5",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@ant-design/icons-angular": "^20.0.0",
    "@mediapipe/hands": "^0.4.1675469240",
    "@microsoft/signalr": "^10.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "apexcharts": "^5.13.0",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.7",
    "exceljs": "^4.4.0",
    "firebase": "^11.10.0",
    "lucide-angular": "^1.0.0",
    "lunar-javascript": "^1.7.7",
    "maplibre-gl": "^5.24.0",
    "markdown-it": "^14.1.1",
    "ng-apexcharts": "^2.4.0",
    "ng-zorro-antd": "^20.4.0",
    "ngx-maplibre-gl": "^12.0.0",
    "ngx-quill": "^30.1.3",
    "ovenplayer": "^0.10.49",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.24",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.7.0",
    "javascript-obfuscator": "^4.2.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "less": "^4.4.0",
    "less-loader": "^12.3.0",
    "pdfjs-dist": "^5.3.93",
    "typescript": "~5.8.2"
  }
}
